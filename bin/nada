#!/usr/bin/env python3
"""nada: a keyboard-driven music player for MPD, with YouTube, lyrics,
autoplay and downloads.

  nada                       open the player, or close it if it's open (toggle)
  nada show | hide | mini    the full player, hidden, the mini player
  nada tab <name>            open on a tab: home queue library youtube playlists downloads
  nada add [--next|--play] <YouTube URL | file | search words>
                             add to the queue (a search plays the top YouTube result)
  nada ctl <command>         control playback without opening anything:
                             toggle play pause stop next prev | seek +10 | seek -10 | seek 1:30
                             vol +5 | vol -5 | vol 40
  nada status [--json]       what's playing
  nada waybar                stream JSON for a waybar custom module (the indicator next to the workspaces)
  nada daemon                start the resident player (sway runs this at login)
  nada quit                  stop it (MPD keeps playing)
  nada --version | --help

The player is one resident process; this script only sends it a D-Bus
message, so it opens at once. `ctl`, `status` and `waybar` talk to MPD
directly and work even when the player isn't running.
"""
import glob
import json
import os
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)
from nada import APP_ID, OBJ, VERSION  # noqa: E402

STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "nada")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "nada")


def running():
    r = subprocess.run(["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                        "org.freedesktop.DBus", "NameHasOwner", "s", APP_ID], capture_output=True, text=True)
    return r.stdout.strip() == "b true"


def gvariant_str(s):
    return "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"


def action(name, param=None):
    params = "[]" if param is None else f"[<{gvariant_str(param)}>]"
    return subprocess.run(["gdbus", "call", "--session", "--dest", APP_ID, "--object-path", OBJ,
                           "--method", "org.gtk.Actions.Activate", name, params, "{}"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode


def ensure_daemon():
    if running():
        return True
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "daemon.log"), "a") as log:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "daemon"], stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True)
    for _ in range(100):
        time.sleep(0.1)
        if running():
            return True
    print(f"nada: the player didn't start (see {STATE}/daemon.log)", file=sys.stderr)
    return False


def client():
    from nada.mpd import Client
    c = Client(timeout=5)
    c.connect()
    return c


def ctl(args):
    from nada.mpd import MPDError
    if not args:
        print("nada ctl toggle|play|pause|stop|next|prev|seek ±N|seek M:SS|vol ±N|vol N", file=sys.stderr)
        return 2
    try:
        c = client()
    except Exception as e:
        print(f"nada: can't reach MPD: {e}", file=sys.stderr)
        return 1
    cmd, arg = args[0], (args[1] if len(args) > 1 else "")
    st = c.status()
    try:
        if cmd in ("toggle", "play-pause"):
            if st.get("state") == "play":
                c.run("pause", "1")
            elif st.get("state") == "pause":
                c.run("pause", "0")
            else:
                c.run("play")
        elif cmd == "play":
            c.run("play") if st.get("state") != "pause" else c.run("pause", "0")
        elif cmd == "pause":
            c.run("pause", "1")
        elif cmd in ("stop", "next"):
            c.run(cmd)
        elif cmd in ("prev", "previous"):
            if float(st.get("elapsed", 0)) > 4:
                c.run("seekcur", "0")
            else:
                c.run("previous")
        elif cmd == "seek":
            if ":" in arg:
                m, s = arg.lstrip("+-").split(":")
                c.run("seekcur", str(int(m) * 60 + int(s)))
            else:
                c.run("seekcur", arg if arg[:1] in "+-" else str(int(arg)))
        elif cmd in ("vol", "volume"):
            v = int(st.get("volume", -1))
            if v < 0:
                print("nada: this MPD output has no volume control", file=sys.stderr)
                return 1
            new = v + int(arg) if arg[:1] in "+-" else int(arg)
            c.run("setvol", str(max(0, min(100, new))))
        else:
            print(f"nada: unknown ctl command {cmd}", file=sys.stderr)
            return 2
    except (MPDError, ValueError) as e:
        print(f"nada: {e}", file=sys.stderr)
        return 1
    return 0


def now(c):
    st = c.status()
    song = c.dict("currentsong") if st.get("state") in ("play", "pause") else {}
    nxt = {}
    if "nextsong" in st:
        items = c.items("playlistinfo", st["nextsong"])
        nxt = items[0] if items else {}
    return st, song, nxt


def fmt(s):
    s = int(float(s or 0))
    return f"{s // 60}:{s % 60:02d}"


def status(args):
    try:
        st, song, nxt = now(client())
    except Exception as e:
        print(f"nada: can't reach MPD: {e}", file=sys.stderr)
        return 1
    info = {"state": st.get("state"), "title": song.get("Title") or os.path.basename(song.get("file", "")),
            "artist": song.get("Artist", ""), "album": song.get("Album", ""), "elapsed": float(st.get("elapsed", 0)),
            "duration": float(st.get("duration", song.get("Time", 0)) or 0), "next": nxt.get("Title", ""),
            "volume": int(st.get("volume", -1))}
    if "--json" in args:
        print(json.dumps(info))
    elif song:
        print(f"{info['state']}: {info['title']} · {info['artist']}  {fmt(info['elapsed'])} / {fmt(info['duration'])}")
    else:
        print("stopped")
    return 0


def waybar():
    """One JSON line per change, for a waybar custom module (return-type json)."""
    from nada.mpd import Client
    frames = ["▂▅▃", "▃▂▅", "▅▃▂", "▃▅▂"]
    idle = Client()
    import threading
    changed = threading.Event()

    def watch():
        while True:
            try:
                if not idle.connected:
                    idle.connect()
                idle.idle("player", "playlist")
                changed.set()
            except Exception:
                idle.close()
                changed.set()
                time.sleep(3)
    threading.Thread(target=watch, daemon=True).start()
    frame, last = 0, None
    c = None
    while True:
        out = {"text": "", "class": "stopped", "tooltip": ""}
        try:
            if c is None:
                c = client()
            st, song, nxt = now(c)
            state = st.get("state")
            if song:
                title = song.get("Title") or os.path.splitext(os.path.basename(song.get("file", "")))[0]
                title = title if len(title) <= 28 else title[:27] + "…"
                icon = frames[frame % len(frames)] if state == "play" else "\U000f03e4"   # moving bars, or a pause sign
                dl = ""
                try:
                    active = json.load(open(os.path.join(CACHE, "downloads.json")))
                    if active:
                        dl = f"  \U000f01da {active[0]['pct']}%"
                except (OSError, ValueError, KeyError, IndexError):
                    pass
                out = {"text": f"{icon}  {title}{dl}", "class": state,
                       "tooltip": f"{song.get('Title', title)}\n{song.get('Artist', '')}"
                                  + (f" · {song['Album']}" if song.get("Album") else "")
                                  + f"\n{fmt(st.get('elapsed'))} / {fmt(st.get('duration', song.get('Time', 0)))}"
                                  + (f"\nNext: {nxt.get('Title')}" if nxt.get("Title") else "")
                                  + "\n\nClick: play / pause · Scroll: back / forward 10 s\nMiddle click: next · Right click: open nāda"}
        except Exception:
            c = None
        esc = lambda t: t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        text = out["text"]
        if text:   # the bars in the accent colour, the title as plain text
            bars, _, rest = text.partition("  ")
            text = f"<span color='#CBA6F7'>{esc(bars)}</span>  {esc(rest)}"
        line = json.dumps({**out, "text": text, "tooltip": esc(out["tooltip"])})
        if line != last:
            try:
                print(line, flush=True)
            except BrokenPipeError:
                return   # waybar went away
            last = line
        playing = out["class"] == "play"
        frame += 1
        changed.wait(0.45 if playing else 30)
        changed.clear()


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "toggle"
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if cmd in ("-V", "--version"):
        print(f"nada {VERSION}")
        return 0
    if cmd == "ctl":
        return ctl(args[1:])
    if cmd == "status":
        return status(args[1:])
    if cmd == "waybar":
        try:
            waybar()
        except (KeyboardInterrupt, BrokenPipeError):
            pass
        try:
            sys.stdout.close()
        except BrokenPipeError:
            pass
        return 0
    if cmd == "quit":
        return action("quit") if running() else 0
    if cmd in ("toggle", "show", "hide", "mini"):
        if cmd == "hide" and not running():
            return 0
        return 0 if ensure_daemon() and action(cmd) == 0 else 1
    if cmd == "tab":
        return 0 if ensure_daemon() and action("tab", args[1] if len(args) > 1 else "home") == 0 else 1
    if cmd == "add":
        where = "end"
        rest = []
        for a in args[1:]:
            if a == "--next":
                where = "next"
            elif a == "--play":
                where = "play"
            else:
                rest.append(a)
        if not rest:
            print("nada add [--next|--play] <YouTube URL | file | search words>", file=sys.stderr)
            return 2
        target = " ".join(rest)
        if os.path.exists(target):
            target = os.path.abspath(target)
        return 0 if ensure_daemon() and action("add", json.dumps({"url": target, "where": where})) == 0 else 1
    if cmd != "daemon":
        print(f"nada: unknown command {cmd} (nada --help)", file=sys.stderr)
        return 2
    if running():
        return 0
    # gtk4-layer-shell (the mini player's corner surface) must load before GTK.
    lib = next(iter(sorted(glob.glob("/usr/lib*/libgtk4-layer-shell.so*") +
                           glob.glob("/usr/lib/*/libgtk4-layer-shell.so*"))), None)
    if lib and lib not in os.environ.get("LD_PRELOAD", ""):
        os.environ["LD_PRELOAD"] = (lib + " " + os.environ.get("LD_PRELOAD", "")).strip()
        os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), "daemon"])
    from nada.app import main as app_main
    return app_main()


if __name__ == "__main__":
    sys.exit(main())
